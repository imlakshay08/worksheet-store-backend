<h1 class="font-display text-2xl font-semibold text-[#211A14] mb-1">Orders</h1>
<div class="h-0.5 w-10 bg-[#A8362B] mb-6"></div>

<%= form_with url: admin_orders_path, method: :get do |f| %>
  <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 mb-6">
    <%= f.text_field :email, value: params[:email], placeholder: "Search by email or name",
          class: "w-full sm:w-64 bg-white/60 rounded-sm border border-[#d8c9a3] px-3 py-2 text-sm text-[#211A14] focus:outline-none focus:border-[#A8362B] focus:ring-2 focus:ring-[#A8362B]/20 transition-colors" %>
    <%= f.select :product_id,
          options_for_select([["All worksheets", ""]] + @products.map { |p| [p.title, p.id] }, params[:product_id]),
          {},
          class: "w-full sm:w-auto sm:max-w-xs bg-white/60 rounded-sm border border-[#d8c9a3] px-3 py-2 text-sm text-[#211A14] focus:outline-none focus:border-[#A8362B] focus:ring-2 focus:ring-[#A8362B]/20 transition-colors",
          onchange: "this.form.submit()" %>
    <%= f.select :status,
          options_for_select([["Paid", "paid"], ["Pending", "pending"]], params[:status]),
          {},
          class: "w-full sm:w-auto bg-white/60 rounded-sm border border-[#d8c9a3] px-3 py-2 text-sm text-[#211A14] focus:outline-none focus:border-[#A8362B] focus:ring-2 focus:ring-[#A8362B]/20 transition-colors" %>
    <div class="flex items-center gap-3">
      <%= f.submit "Filter",
            class: "flex-1 sm:flex-none bg-[#A8362B] text-[#F6EFDD] hover:bg-[#8f2c22] rounded-md px-4 py-2 text-sm font-medium cursor-pointer transition-colors" %>
      <%= link_to "Reset", admin_orders_path, class: "px-4 py-2 text-sm text-[#6b5f4f] hover:text-[#211A14]" %>
    </div>
  </div>
<% end %>

<div class="rounded-md md:border md:border-[#E7DFC9] md:bg-[#FFFEFB] md:overflow-hidden">
  <table class="responsive-table w-full text-sm">
    <thead class="text-[#9C8C72] border-b border-[#EFE7D2]">
      <tr>
        <th class="text-left font-medium px-5 py-3">Customer</th>
        <th class="text-left font-medium px-5 py-3">Product</th>
        <th class="text-left font-medium px-5 py-3">Amount</th>
        <th class="text-left font-medium px-5 py-3">Location</th>
        <th class="text-left font-medium px-5 py-3">Status</th>
        <th class="text-left font-medium px-5 py-3">Email</th>
        <th class="text-left font-medium px-5 py-3">Date</th>
      </tr>
    </thead>
    <tbody class="md:divide-y md:divide-[#EFE7D2]">
      <% @orders.each do |order| %>
        <tr class="md:hover:bg-[#FAF6EC]">
          <td data-label="Customer" class="px-5 py-3">
            <div>
              <%= link_to admin_order_path(order, page: @page, product_id: params[:product_id].presence, status: params[:status].presence, email: params[:email].presence), class: "text-[#A8362B] hover:text-[#8f2c22] font-medium" do %>
                <%= order.name.presence || order.email.presence || "—" %>
              <% end %>
              <div class="text-xs text-[#9C8C72]"><%= order.email %></div>
            </div>
          </td>
          <td data-label="Product" class="px-5 py-3"><%= order.worksheets_summary %></td>
          <td data-label="Amount" class="px-5 py-3"><%= order.display_amount %></td>
          <td data-label="Location" class="px-5 py-3 text-[#6b5f4f]"><%= [order.city, order.country].compact_blank.join(", ").presence || "—" %></td>
          <td data-label="Status" class="px-5 py-3">
            <% status_class = case order.status
                              when "paid"     then "bg-[#E5EEE0] text-[#2F5233] border-[#2F5233]/25"
                              when "refunded" then "bg-[#EFE7D2] text-[#6b5f4f] border-[#9C8C72]/25"
                              else                 "bg-[#F5E9D0] text-[#8a6d1f] border-[#8a6d1f]/25"
                              end %>
            <span class="inline-flex px-2 py-0.5 rounded-md text-xs font-medium border <%= status_class %>">
              <%= order.status %>
            </span>
          </td>
          <td data-label="Email" class="px-5 py-3">
            <% if order.status != "paid" %>
              <span class="text-[#9C8C72]">—</span>
            <% elsif order.download_email_sent_at %>
              <span class="inline-flex px-2 py-0.5 rounded-md text-xs font-medium border bg-[#E5EEE0] text-[#2F5233] border-[#2F5233]/25"
                    title="Sent <%= order.download_email_sent_at.strftime('%d %b %Y, %H:%M') %>">Sent</span>
            <% else %>
              <span class="inline-flex px-2 py-0.5 rounded-md text-xs font-medium border bg-[#FBF0EC] text-[#7a1f17] border-[#A8362B]">Not sent</span>
            <% end %>
          </td>
          <td data-label="Date" class="px-5 py-3 text-[#6b5f4f]"><%= order.created_at.strftime("%d %b %Y, %H:%M") %></td>
        </tr>
      <% end %>

      <% if @orders.empty? %>
        <tr><td colspan="7" class="px-5 py-6 text-center text-[#9C8C72]">No orders match.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @total_count > 0 %>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mt-4 text-sm text-[#6b5f4f]">
    <span>
      Showing <%= (@page - 1) * @per_page + 1 %>–<%= [@page * @per_page, @total_count].min %> of <%= @total_count %> orders
    </span>
    <% if @total_pages > 1 %>
      <div class="flex items-center gap-1">
        <% if @page > 1 %>
          <%= link_to "‹ Prev", admin_orders_path(email: params[:email].presence, status: params[:status].presence, product_id: params[:product_id].presence, page: @page - 1),
                class: "px-3 py-1.5 rounded-md border border-[#E7DFC9] hover:bg-[#FAF6EC] text-[#211A14]" %>
        <% else %>
          <span class="px-3 py-1.5 rounded-md border border-[#EFE7D2] text-[#c9bfa6]">‹ Prev</span>
        <% end %>
        <span class="px-3 py-1.5">Page <%= @page %> of <%= @total_pages %></span>
        <% if @page < @total_pages %>
          <%= link_to "Next ›", admin_orders_path(email: params[:email].presence, status: params[:status].presence, product_id: params[:product_id].presence, page: @page + 1),
                class: "px-3 py-1.5 rounded-md border border-[#E7DFC9] hover:bg-[#FAF6EC] text-[#211A14]" %>
        <% else %>
          <span class="px-3 py-1.5 rounded-md border border-[#EFE7D2] text-[#c9bfa6]">Next ›</span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
