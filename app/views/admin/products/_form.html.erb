<% label_class = "block text-[11px] tracking-[0.15em] font-semibold uppercase text-[#8a7d63] mb-1.5" %>
<% input_class = "w-full bg-white/60 rounded-sm border border-[#d8c9a3] px-3 py-2.5 text-sm text-[#211A14] focus:outline-none focus:border-[#A8362B] focus:ring-2 focus:ring-[#A8362B]/20 transition-colors" %>

<%= form_with model: [:admin, product], local: true,
      html: { class: "relative bg-[#FFFEFB] border border-[#E7DFC9] rounded-md overflow-hidden p-6 pl-7 max-w-2xl space-y-5" } do |form| %>
  <span class="absolute left-0 top-0 bottom-0 w-1 bg-[#A8362B]"></span>

  <% if product.errors.any? %>
    <div class="rounded-sm bg-[#FBF0EC] border border-[#A8362B] px-4 py-3 text-sm text-[#7a1f17]">
      <ul class="list-disc list-inside">
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: label_class %>
    <%= form.text_field :title, class: input_class %>
  </div>

  <div>
    <%= form.label :description, class: label_class %>
    <%= form.text_area :description, rows: 4, class: input_class %>
  </div>

  <div>
    <%= form.label :level, "Level badge (optional, e.g. A2–B1 — shown on the worksheet card)", class: label_class %>
    <%= form.text_field :level, placeholder: "A2–B1", class: input_class %>
  </div>

  <div>
    <%= form.label :price_in_rupees, "Price in ₹ (just type the rupee amount, e.g. 79)", class: label_class %>
    <%= form.number_field :price_in_rupees, step: 0.01, min: 0, class: input_class %>
  </div>

  <div>
    <%= form.label :price_in_usd, "International price in $ (for PayPal, e.g. 4.99 — leave blank to hide PayPal for this worksheet)", class: label_class %>
    <%= form.number_field :price_in_usd, step: 0.01, min: 0, class: input_class %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :active, class: "rounded border-[#d8c9a3] text-[#A8362B] focus:ring-[#A8362B]/30" %>
    <%= form.label :active, "Active (visible for sale)?", class: "text-sm font-medium text-[#211A14]" %>
  </div>

  <div>
    <%= form.label :worksheet_pdf, "Worksheet PDF", class: label_class %>
    <%= form.file_field :worksheet_pdf, accept: "application/pdf", class: "block text-sm text-[#6b5f4f]" %>
    <p class="text-xs text-[#9C8C72] mt-1">🪄 Upload straight from Canva — large files are compressed &amp; optimized automatically, so downloads stay fast. Just choose the file and Save.</p>
    <% if product.worksheet_pdf.attached? %>
      <p class="text-xs text-[#9C8C72] mt-1">
        Current file: <%= product.worksheet_pdf.filename %><%= " · #{product.page_count} pages detected" if product.page_count.present? %>
        · <%= link_to "View PDF", rails_blob_path(product.worksheet_pdf, disposition: "inline"),
                target: "_blank", rel: "noopener",
                class: "text-[#A8362B] hover:text-[#8f2c22] underline" %>
      </p>
    <% end %>
  </div>

  <div>
    <%= form.label :preview_image, "Preview image (page 1 — shown to buyers as “What’s inside”)", class: label_class %>
    <%= form.file_field :preview_image, accept: "image/*", class: "block text-sm text-[#6b5f4f]" %>
    <% if product.preview_image.attached? %>
      <div class="mt-2">
        <%= link_to rails_blob_path(product.preview_image, disposition: "inline"), target: "_blank", rel: "noopener" do %>
          <%= image_tag rails_blob_path(product.preview_image, disposition: "inline"), class: "h-28 rounded border border-[#E7DFC9]" %>
        <% end %>
      </div>
    <% end %>
    <p class="text-xs text-[#9C8C72] mt-1">A JPG/PNG of the first page — buyers see this before paying, so pick a page you're happy to show. It's automatically resized &amp; optimized for you.</p>
  </div>

  <div>
    <%= form.submit "Save",
          class: "bg-[#A8362B] text-[#F6EFDD] hover:bg-[#8f2c22] rounded-md px-5 py-2.5 text-sm font-semibold uppercase tracking-[0.1em] cursor-pointer transition-colors" %>
  </div>
<% end %>

<script>
  /* Reject oversized files in the browser BEFORE upload, so a huge file can
     never stall or crash the server. (The server also enforces these limits.) */
  (function () {
    var LIMITS = {
      product_worksheet_pdf: { mb: 45, label: "PDF" },
      product_preview_image: { mb: 25, label: "image" }
    };
    Object.keys(LIMITS).forEach(function (id) {
      var input = document.getElementById(id);
      if (!input) return;
      input.addEventListener("change", function () {
        var f = input.files && input.files[0];
        var max = LIMITS[id].mb * 1024 * 1024;
        if (f && f.size > max) {
          alert("That " + LIMITS[id].label + " is " + (f.size / 1048576).toFixed(0) +
                " MB, which is unusually large. Please use a smaller export " +
                "(in Canva: Download → PDF Standard).\n\nEverything up to " + LIMITS[id].mb +
                " MB is compressed and optimized automatically after upload — you don't need to do anything.");
          input.value = "";
        }
      });
    });
  })();
</script>
